<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:gravity="center"
    android:orientation="vertical" android:padding="48dp">

    <Button
        android:id="@+id/cleanBtn"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:focusable="true" android:focusableInTouchMode="true"
        android:minWidth="360dp" android:minHeight="80dp"
        android:text="@string/clean" android:textSize="24sp"/>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:text="@string/ready"
        android:textColor="#FFFFFF" android:textSize="22sp"/>
</LinearLayout>
